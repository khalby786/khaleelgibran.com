    <meta property="og:image" content="https://khaleelgibran.com/favicon.png" />
    <script defer src="https://analytics.khaleelgibran.com/script.js" data-website-id="8d9112d6-9543-4a41-9f44-c998751b7324"></script>
  </head>

  <body>
    <main class="px-5 py-10">
      <Cursors client:only="vue" />
      <Header />
      <Hero />
      <Projects />
      <Posts client:load />
      <Event />
      <Spotify client:visible />
      <Webring />
      <Footer />
