    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" href="/favicon.ico" />
    <title>khaleel gibran</title>
    <link rel="me" href="https://glitch.com/@khalby786" />
    <meta property="og:title" content="khaleel gibran" />
